@page
@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "_LayoutSimple";
}
<div class="min-vh-100 d-grid" style="place-items:center">
    <div class="card p-4 text-center" style="max-width:440px">
        <div class="empty-icon mx-auto mb-3 tone-danger" style="width:64px;height:64px;border-radius:50%;display:grid;place-items:center;font-size:1.75rem"><i class="bi bi-shield-x"></i></div>
        <h1 class="h4">No tienes permiso para esta sección</h1>
        <p class="text-muted">Solo el Administrador puede modificar el catálogo, los precios, los empleados y consultar la auditoría (RN-13).</p>
        <a class="btn btn-primary" href="/"><i class="bi bi-house"></i>Volver al tablero</a>
    </div>
</div>
