<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Florecitas.Rentas.Web</RootNamespace>
    <!-- La cadena de conexión se guarda con "dotnet user-secrets" (fuera del repositorio) -->
